rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function guildDoc(guildId) {
      return get(/databases/$(database)/documents/guilds/$(guildId));
    }

    function isOwner(guildId) {
      return signedIn()
        && guildDoc(guildId).data.ownerId == request.auth.uid;
    }

    function subDoc(guildId) {
      return get(/databases/$(database)/documents/guilds/$(guildId)/subLeaders/$(request.auth.uid));
    }

    function isSubLeader(guildId) {
      return signedIn()
        && exists(/databases/$(database)/documents/guilds/$(guildId)/subLeaders/$(request.auth.uid));
    }

    function canEditGuild(guildId) {
      return isOwner(guildId)
        || (
          isSubLeader(guildId)
          && subDoc(guildId).data.canEditGuild == true
        );
    }

    function canEditLine(guildId, lineId) {
      return canEditGuild(guildId)
        || (
          isSubLeader(guildId)
          && subDoc(guildId).data.allowedLineIds is list
          && subDoc(guildId).data.allowedLineIds.hasAny([lineId])
        );
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /guilds/{guildId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if canEditGuild(guildId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["verified"]);

      allow delete: if signedIn()
        && resource.data.ownerId == request.auth.uid;

      match /applications/{applicationId} {
        // Qualquer visitante pode enviar uma inscrição, mas somente com status inicial pendente.
        allow create: if request.resource.data.guildId == guildId
          && request.resource.data.status == "pending"
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 80
          && request.resource.data.age is int
          && request.resource.data.age >= 10
          && request.resource.data.age <= 100
          && request.resource.data.contact is string
          && request.resource.data.contact.size() >= 8
          && request.resource.data.contact.size() <= 30;

        allow read: if isOwner(guildId);

        allow update: if isOwner(guildId)
          && request.resource.data.guildId == resource.data.guildId
          && request.resource.data.name == resource.data.name
          && request.resource.data.age == resource.data.age
          && request.resource.data.contact == resource.data.contact
          && request.resource.data.status in ["pending", "accepted", "rejected"];

        allow delete: if isOwner(guildId);
      }

      match /logs/{logId} {
        allow read: if signedIn()
          && (
            isOwner(guildId)
            || isSubLeader(guildId)
          );

        allow create: if signedIn()
          && (
            isOwner(guildId)
            || isSubLeader(guildId)
          )
          && request.resource.data.actorUid == request.auth.uid;

        allow update, delete: if false;
      }

      match /subLeaders/{subId} {
        allow read: if signedIn()
          && (
            isOwner(guildId)
            || resource.data.uid == request.auth.uid
          );

        allow create, update, delete: if isOwner(guildId);
      }

      match /lines/{lineId} {
        allow read: if true;

        allow create: if canEditGuild(guildId);

        allow update: if canEditLine(guildId, lineId);

        allow delete: if canEditGuild(guildId);

        match /players/{playerId} {
          allow read: if true;

          allow create, update, delete: if canEditLine(guildId, lineId);
        }
      }
    }
  }
}
